{
  "name": "pnote",
  "version": "0.1.0",
  "description": "Local project issues and notes from your terminal",
  "type": "module",
  "bin": { "pno": "dist/cli/main.js" },
  "files": ["dist", "README.md"],
  "engines": { "node": "24.x || 26.x" },
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "pnpm build && node --import tsx --test test/*.test.ts",
    "dev": "tsc -p tsconfig.json --watch",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@clack/prompts": "^1.0.0",
    "better-sqlite3": "^12.10.0",
    "commander": "^14.0.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0"
  }
}
